# ---- Runtime ----
NODE_ENV=development
PORT=4000
# Public base URL of the API. Used to build absolute links in emails.
API_BASE_URL=http://localhost:4000

# ---- Database ----
# docker-compose overrides DB_HOST with the `db` service name.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/padosipro?schema=public

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-a-32-byte-random-string
JWT_EXPIRES_IN=7d

# ---- OTP policy ----
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ---- Password hashing ----
BCRYPT_SALT_ROUNDS=10

# ---- Mail catcher ----
# MAIL_TRANSPORT=ethereal  -> auto-creates a throwaway Ethereal account and logs
#                             the preview URL on boot (default, no signup needed)
# MAIL_TRANSPORT=smtp       -> real SMTP server, see the SMTP_* values below
# MAIL_TRANSPORT=json      -> writes .eml payloads to ./tmp-mail (used by tests)
MAIL_TRANSPORT=smtp
MAIL_FROM_NAME=PadosiPro
MAIL_FROM_ADDRESS=you@example.com

# Only needed when MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
